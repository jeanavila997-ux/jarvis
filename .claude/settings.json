{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(node --test *)",
      "Bash(node codex/bin/jarvis-ask.mjs *)",
      "Bash(./codex/bin/jarvis-ask.mjs *)",
      "Bash(codex/bin/hermes-tarefa.sh *)",
      "Bash(./codex/bin/hermes-tarefa.sh *)",
      "Bash(codex/bin/hermes-tarefa.ps1 *)",
      "Bash(./codex/bin/hermes-tarefa.ps1 *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./vault/**)",
      "Read(./data/**)",
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git filter-branch *)",
      "Bash(sudo *)"
    ]
  }
}
