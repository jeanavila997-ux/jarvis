# Copie para .env (chmod 600). Nunca commite o .env.
OLLAMA_API_KEY=
# Opcional: modelo do Ollama Cloud (padrão glm-5.3-flash). Sem fallback automático.
JARVIS_MODEL=glm-5.3-flash
OLLAMA_URL=https://ollama.com
# Hash de basic-auth do Traefik (usuário:hash), entre aspas simples. Prefira bcrypt ($2y$) ao apr1.
# Gere na VPS sem a senha ir para o histórico: htpasswd -nB SEU_USUARIO  (o comando pede a senha)
# Use um usuário que não seja óbvio e uma senha longa (4+ palavras aleatórias).
JARVIS_BASICAUTH_USERS='SEU_USUARIO:$2y$...'
# Lista de IPs/faixas que podem acessar (opcional; só vale se a linha jarvis-ips do compose for ligada).
# Ex.: 203.0.113.10/32,198.51.100.0/24
# JARVIS_IP_ALLOWLIST=
# Telegram (opcional): token do @Agenteejarvis_bot e o chat id do Jean (único aceito).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
# Roteador (Etapa 1): Ollama LOCAL da VPS para classificar e responder conversa trivial.
# Vazio = desligado. Hoje o Ollama escuta só em 127.0.0.1 e o container não alcança: deixe vazio.
JARVIS_LOCAL_URL=
JARVIS_LOCAL_MODEL=llama3.2:3b
# Reserva 9Router do PC do Jean (OpenAI-compatível; cai quando o PC desliga). 1 = liga. Só usada se a nuvem falhar.
NINEROUTER_RESERVA=0
NINEROUTER_URL=https://rvejurm.abc-tunnel.us/v1
NINEROUTER_MODEL=
NINEROUTER_API_KEY=
# nvidia-app do PC (via proxy allowlist na VPS). Desligado. Sem túnel no ar; não preencha até o Jean confirmar o desenho.
NVIDIA_APP=0
NVIDIA_PROXY_URL=
NVIDIA_PROXY_TOKEN=

# Hermes (API no host, via Unix socket). Sem chave = só /health. Não invente a chave.
HERMES_URL=
HERMES_API_KEY=
# nvidia-app: no JARVIS local use NVIDIA_MCP_URL; na VPS use o proxy (desligado até o túnel existir).
NVIDIA_MCP_URL=

# Docker MCP Gateway (GitHub Official, leitura). Desligado no código se DOCKER_MCP!=1.
# Token só no .env / .env.local, nunca neste exemplo.
# DOCKER_MCP=0
# DOCKER_MCP_URL=
# DOCKER_MCP_TOKEN=

# Mestre do PC (MCP do PC via túnel reverso + socket; docs/RODAR-NO-PC.md). 0 = desligado.
MESTRE_MCP=0
MESTRE_MCP_URL=unix:///app/run/mestre.sock
MESTRE_MCP_TOKEN=
# Nomes extras de ferramentas de LEITURA, separados por vírgula (depois de medir com /mestre)
MESTRE_MCP_EXTRA_LEITURA=

# Voicebox (TTS). API SEM autenticação: só socket/loopback. 0 = desligado (padrão).
# Prefere o PC (VOICEBOX_PC_URL) quando o túnel estiver no ar; senão usa a VPS.
VOICEBOX=0
VOICEBOX_URL=unix:///app/run/voicebox.sock
VOICEBOX_PC_URL=unix:///app/run/voicebox-pc.sock
VOICEBOX_PROFILE_ID=
VOICEBOX_LANGUAGE=pt
VOICEBOX_ENGINE=kokoro
VOICEBOX_TIMEOUT_MS=180000
VOICEBOX_FFMPEG=ffmpeg

# Privacidade do vault na rota nuvem (Ollama Cloud, reserva 9Router).
# Marque notas no frontmatter com  sensibilidade: privada  (ou confidencial),  nuvem: nao  ou a tag  privado.
#   sem-privadas (padrão): manda trechos do vault, menos os privados
#   nada: nunca manda trechos do vault para fora
#   tudo: comportamento antigo
JARVIS_VAULT_NUVEM=sem-privadas
