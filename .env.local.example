# Copie para .env.local (ACL restrita). Nunca commite.
# Sem segredos neste exemplo. Chaves que faltarem: peça ao Grok Bot — não invente.
# Telegram fica VAZIO de propósito: o mesmo bot na VPS e no PC geraria conflito de polling.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Ollama do PC (qwen3:4b na RTX 3050). host.docker.internal é o PC, visto de dentro do container.
OLLAMA_URL=http://host.docker.internal:11434
JARVIS_MODEL=qwen3:4b
JARVIS_LOCAL_URL=http://host.docker.internal:11434
JARVIS_LOCAL_MODEL=qwen3:4b
# OLLAMA_API_KEY=   # só se for usar a nuvem; o Ollama local não precisa

# 9Router do PC (reserva DESLIGADA: nenhum modelo de chat gratuito responde agora).
NINEROUTER_RESERVA=0
NINEROUTER_URL=http://host.docker.internal:20128/v1
NINEROUTER_MODEL=
# NINEROUTER_API_KEY=  # peça ao Grok Bot se for ligar a reserva, STT ou TTS

# nvidia-app do PC, só LEITURA (allowlist no código).
NVIDIA_APP=0   # 1 liga (só LEITURA)
NVIDIA_MCP_URL=http://host.docker.internal:13508/mcp

# Basic-auth do site local (além do bind em 127.0.0.1). Preencha com valores do Grok Bot; não invente.
# JARVIS_BASIC_USER=
# JARVIS_BASIC_PASS=

HOST=0.0.0.0
PORT=3200
TZ=America/Rio_Branco

# Mestre do PC (launcher no Windows, 127.0.0.1:7777). 0 = desligado.
MESTRE_MCP=0
MESTRE_MCP_URL=http://host.docker.internal:7777
MESTRE_MCP_TOKEN=
MESTRE_MCP_EXTRA_LEITURA=

# Voicebox no próprio PC (porta só em 127.0.0.1:17493). 0 = desligado.
VOICEBOX=0
VOICEBOX_URL=http://host.docker.internal:17493
VOICEBOX_PC_URL=
VOICEBOX_PROFILE_ID=
VOICEBOX_LANGUAGE=pt
VOICEBOX_ENGINE=kokoro
