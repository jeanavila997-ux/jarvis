{
  "manifest_version": 3,
  "name": "JARVIS — Jean Carlos",
  "version": "1.0.0",
  "description": "Converse com o JARVIS local ou da VPS no Chrome e Microsoft Edge.",
  "action": {
    "default_title": "Abrir JARVIS",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:3200/*",
    "http://localhost:3200/*",
    "https://jarvis.72-62-11-116.sslip.io/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
