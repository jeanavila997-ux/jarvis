# Instalada na VPS em 21/11, mas PARADA e DESABILITADA até o túnel reverso do PC existir
# (docs/RODAR-NO-PC.md, seção 7). Ligar com: systemctl enable --now jarvis-mestre-proxy
# Mesmo padrão do Hermes: sem porta TCP nova, sem UFW. O túnel entrega o MCP do PC em
# 127.0.0.1:17777 da VPS; este socat expõe isso só no socket montado no container JARVIS.
[Unit]
Description=Unix socket proxy from JARVIS container to Mestre do PC MCP via SSH tunnel (127.0.0.1:17777)
After=network.target

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /opt/apps/jarvis/run
ExecStartPre=/bin/chown 1000:1000 /opt/apps/jarvis/run
ExecStart=/usr/bin/socat UNIX-LISTEN:/opt/apps/jarvis/run/mestre.sock,fork,reuseaddr,unlink-early,mode=660,user=1000,group=1000 TCP:127.0.0.1:17777
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
