# Instalada na VPS, mas PARADA e DESABILITADA até o túnel reverso do PC existir
# (docs/RODAR-NO-PC.md e docs/VOICEBOX.md). Ligar com: systemctl enable --now jarvis-voicebox-pc-proxy
# O túnel entrega o Voicebox do PC em 127.0.0.1:17494 da VPS (17493 na VPS é o Voicebox local).
[Unit]
Description=Unix socket proxy from JARVIS container to Voicebox PC via SSH tunnel (127.0.0.1:17494)
After=network.target

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /opt/apps/jarvis/run
ExecStartPre=/bin/chown 1000:1000 /opt/apps/jarvis/run
ExecStart=/usr/bin/socat UNIX-LISTEN:/opt/apps/jarvis/run/voicebox-pc.sock,fork,reuseaddr,unlink-early,mode=660,user=1000,group=1000 TCP:127.0.0.1:17494
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
