# Proxy do Voicebox da VPS (127.0.0.1:17493) para o socket do container JARVIS.
# Sem porta TCP nova, sem UFW, sem Traefik. A API do Voicebox NÃO tem senha.
[Unit]
Description=Unix socket proxy from JARVIS container to Voicebox VPS (127.0.0.1:17493)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /opt/apps/jarvis/run
ExecStartPre=/bin/chown 1000:1000 /opt/apps/jarvis/run
ExecStart=/usr/bin/socat UNIX-LISTEN:/opt/apps/jarvis/run/voicebox.sock,fork,reuseaddr,unlink-early,mode=660,user=1000,group=1000 TCP:127.0.0.1:17493
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
